# LLM (OpenAI-compatible). Default: DeepSeek.
# Get a key: https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Max wait for chat/completions (ms); expand/generate fail with 504 if exceeded
LLM_TIMEOUT_MS=120000

DATABASE_PATH=./data/slide_maker.db
CORS_ORIGINS=http://localhost:5173
CONTENT_DECKS_PATH=../../content/decks
MAX_SLIDES=12
MAX_OUTLINE_CHAPTERS=6
PORT=8000
